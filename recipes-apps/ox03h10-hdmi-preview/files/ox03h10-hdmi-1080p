#!/usr/bin/env bash
# OX03H10 -> TI VISS -> center-crop 1920x1080 -> HDMI 1920x1080.
set -euo pipefail

MEDIA_DEVICE=${MEDIA_DEVICE:-/dev/media0}
VIDEO_DEVICE=${VIDEO_DEVICE:-/dev/video3}
DRM_DEVICE=${DRM_DEVICE:-30220000.dss}
CONNECTOR_ID=${CONNECTOR_ID:-41}
PLANE_ID=${PLANE_ID:-32}
DCC_VISS_FILE=${DCC_VISS_FILE:-/opt/imaging/ox03h10/wdr/dcc_viss_wdr_304.bin}
DCC_2A_FILE=${DCC_2A_FILE:-/opt/imaging/ox03h10/wdr/dcc_2a_wdr_304.bin}
MSC_WORKAROUND=${MSC_WORKAROUND:-/usr/lib/ox03h10/ox03h10-msc-release-workaround.so}
CROP_Y=${CROP_Y:-228}

for path in "$MEDIA_DEVICE" "$VIDEO_DEVICE" "$DCC_VISS_FILE" "$DCC_2A_FILE" "$MSC_WORKAROUND"; do
    [[ -e "$path" ]] || { echo "Missing required path: $path" >&2; exit 1; }
done

old=$(pgrep -f "^gst-launch-1.0 .*video3 .*plane-id=$PLANE_ID" || true)
if [[ -n "$old" ]]; then
    echo "Stopping previous HDMI preview: $old" >&2
    kill $old
    sleep 2
fi

for entity in \
    "max96717 5-0040" \
    "max96716a 4-0028" \
    "cdns_csi2rx.30101000.csi-bridge" \
    "30102000.ticsi2rx"
do
    media-ctl -d "$MEDIA_DEVICE" --set-v4l2 \
        "\"$entity\":0[fmt:SBGGR12_1X12/1920x1536 field:none]"
done

export LD_PRELOAD="$MSC_WORKAROUND"
exec gst-launch-1.0 -e \
    v4l2src device="$VIDEO_DEVICE" io-mode=dmabuf \
    ! video/x-bayer,format=bggr12,width=1920,height=1536,framerate=60/1 \
    ! tiovxisp sensor-name=SENSOR_OX03H10 format-msb=11 num-exposures=1 \
        wdr-enabled=true bypass-dwb=true \
        dcc-isp-file="$DCC_VISS_FILE" \
        sink_0::dcc-2a-file="$DCC_2A_FILE" \
        sink_0::ae-mode=2 sink_0::awb-mode=2 sink_0::pool-size=4 \
    ! video/x-raw,format=NV12,width=1920,height=1536,framerate=60/1 \
    ! tiovxmultiscaler name=multi target=VPAC_MSC1 sink::pool-size=4 \
        sink::roi-startx=0 sink::roi-starty="$CROP_Y" \
        sink::roi-width=1920 sink::roi-height=1080 \
        src_0::pool-size=8 multi. \
    ! video/x-raw,format=NV12,width=1920,height=1080,framerate=60/1 \
    ! queue leaky=downstream max-size-buffers=2 \
    ! fpsdisplaysink text-overlay=false sync=false \
        video-sink="kmssink driver-name=tidss bus-id=$DRM_DEVICE connector-id=$CONNECTOR_ID plane-id=$PLANE_ID sync=false force-modesetting=true"
