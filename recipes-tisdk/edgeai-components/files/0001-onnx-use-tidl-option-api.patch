Subject: [PATCH] Use the 11.02 TIDL provider option API

Upstream-Status: Inappropriate [SDK component version compatibility]

--- a/dl_inferer/src/ti_onnx_inferer.cpp
+++ b/dl_inferer/src/ti_onnx_inferer.cpp
@@ -245,10 +245,10 @@
     if (m_enableTidl)
     {
         sessionOpts.SetIntraOpNumThreads(1);
-        OrtStatus *def_status = OrtSessionsOptionsSetDefault_Tidl(&tidlOpts);
-        strcpy(tidlOpts.artifacts_folder, m_artifactPath.c_str());
-        tidlOpts.core_number = m_coreNumber;
-        tidlOpts.debug_level = m_debug_level;
+        Ort::ThrowOnError(OrtSessionOptionsInitialize_Tidl(&tidlOpts));
+        Ort::ThrowOnError(OrtSessionOptionsSet_Tidl(&tidlOpts, "artifacts_folder", m_artifactPath.c_str()));
+        Ort::ThrowOnError(OrtSessionOptionsSet_Tidl(&tidlOpts, "core_number", std::to_string(m_coreNumber).c_str()));
+        Ort::ThrowOnError(OrtSessionOptionsSet_Tidl(&tidlOpts, "debug_level", std::to_string(m_debug_level).c_str()));
         ortStatus = OrtSessionOptionsAppendExecutionProvider_Tidl(sessionOpts,
                                                                 &tidlOpts);
     }
