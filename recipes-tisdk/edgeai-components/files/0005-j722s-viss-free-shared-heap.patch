From: BeagleY AI integration <noreply@example.com>
Subject: [PATCH] viss: free J722S shared image buffers from shared heap

OpenVX allocates RAW, image and user-data handles from the DMA shared
heap on J722S Linux. Free them using the same heap.

Upstream-Status: Inappropriate [BeagleY integration]

--- a/src/tiovx_viss_module.c
+++ b/src/tiovx_viss_module.c
@@ -62,6 +62,12 @@
 
 #include "tiovx_viss_module.h"
 #include <itt_server.h>
+
+#if defined(SOC_J722S) && defined(TARGET_OS_LINUX)
+#define TIOVX_VISS_BUFFER_HEAP TIVX_MEM_EXTERNAL_SHARED
+#else
+#define TIOVX_VISS_BUFFER_HEAP TIVX_MEM_EXTERNAL
+#endif
 
 static vx_status tiovx_viss_module_configure_params(vx_context context, TIOVXVISSModuleObj *obj)
 {
@@ -1086,7 +1092,7 @@
                         if(virtAddr[ctr] != NULL)
                         {
                             TIOVX_MODULE_PRINTF("[VISS-MODULE] Freeing raw input, bufq=%d, ch=%d, addr = 0x%016lX, size = %d \n", bufq, ch, (vx_uint64)virtAddr[ctr], size[ctr]);
-                            tivxMemFree(virtAddr[ctr], size[ctr], TIVX_MEM_EXTERNAL);
+                            tivxMemFree(virtAddr[ctr], size[ctr], TIOVX_VISS_BUFFER_HEAP);
                         }
                     }
 
@@ -1133,7 +1139,7 @@
                         if(virtAddr[ctr] != NULL)
                         {
                             TIOVX_MODULE_PRINTF("[VISS-MODULE] Freeing ae-awb result, bufq=%d, ch=%d, addr = 0x%016lX, size = %d \n", bufq, ch, (vx_uint64)virtAddr[ctr], size[ctr]);
-                            tivxMemFree(virtAddr[ctr], size[ctr], TIVX_MEM_EXTERNAL);
+                            tivxMemFree(virtAddr[ctr], size[ctr], TIOVX_VISS_BUFFER_HEAP);
                         }
                     }
 
@@ -1180,7 +1186,7 @@
                         if(virtAddr[ctr] != NULL)
