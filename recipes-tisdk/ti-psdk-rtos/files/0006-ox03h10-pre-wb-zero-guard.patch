From: BeagleY AI integration <noreply@example.com>
Subject: [PATCH] ti-2a-wrapper: guard sensor pre-WB normalization

Do not divide H3A statistics by a zero previous color gain. Use the TI Q9
unity value as fallback for each color channel.

Upstream-Status: Inappropriate [BeagleY integration]

--- a/imaging/ti_2a_wrapper/src/ti_2a_wrapper.c
+++ b/imaging/ti_2a_wrapper/src/ti_2a_wrapper.c
@@ -899,6 +899,19 @@
         rGain_prev = aewb_prev->wb_gains[rIndex];
         gGain_prev = (aewb_prev->wb_gains[grIndex]+aewb_prev->wb_gains[gbIndex])/2;
         bGain_prev = aewb_prev->wb_gains[bIndex];
+        /* A zero/uninitialized previous gain cannot be used as divisor. */
+        if (0U == rGain_prev)
+        {
+            rGain_prev = 512U;
+        }
+        if (0U == gGain_prev)
+        {
+            gGain_prev = 512U;
+        }
+        if (0U == bGain_prev)
+        {
+            bGain_prev = 512U;
+        }
         for (paxelIndex = 0; paxelIndex < n_pax; paxelIndex++)
         {
             h3a_paxel_data = pFrame_data->h3a_res[paxelIndex];
